{
  "name": "ChatWave Enterprise Design System",
  "version": "2.0.0",
  "author": "Bhavik (whosh289@gmail.com)",
  "figma_spec": {
    "file_type": "DESIGN_TOKENS_AND_STYLE_SPEC",
    "theme": "Executive Dark Glass (Linear/Raycast inspired)",
    "typography": {
      "font_family_body": "Plus Jakarta Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "font_family_display": "Outfit, Plus Jakarta Sans, sans-serif",
      "font_family_mono": "JetBrains Mono, SF Mono, monospace",
      "scale": {
        "caption": { "size": "11px", "lineHeight": "14px", "letterSpacing": "0.02em" },
        "body_sm": { "size": "13px", "lineHeight": "18px", "letterSpacing": "-0.01em" },
        "body_md": { "size": "14px", "lineHeight": "21px", "letterSpacing": "-0.01em" },
        "subheading": { "size": "16px", "lineHeight": "22px", "letterSpacing": "-0.02em", "weight": "600" },
        "heading": { "size": "20px", "lineHeight": "26px", "letterSpacing": "-0.03em", "weight": "700" }
      }
    },
    "colors": {
      "surface_base": "#090a10",
      "surface_card": "#0e111a",
      "surface_sidebar": "#0b0d14",
      "surface_border": "rgba(255, 255, 255, 0.08)",
      "surface_border_subtle": "rgba(255, 255, 255, 0.04)",
      "surface_border_active": "rgba(99, 102, 241, 0.4)",
      "brand_primary": "#6366f1",
      "brand_primary_gradient": "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)",
      "brand_received_gradient": "linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%)",
      "brand_accent": "#10b981",
      "brand_danger": "#f43f5e",
      "text_primary": "#f8fafc",
      "text_secondary": "rgba(248, 250, 252, 0.65)",
      "text_muted": "rgba(248, 250, 252, 0.4)"
    },
    "elevation": {
      "shadow_bento": "0 25px 60px -15px rgba(0, 0, 0, 0.9), inset 0 1px 0 0 rgba(255, 255, 255, 0.1)",
      "shadow_bubble_sent": "0 4px 16px rgba(99, 102, 241, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2)",
      "shadow_bubble_received": "0 2px 10px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06)",
      "shadow_popover": "0 20px 45px -10px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.12)"
    },
    "radii": {
      "card": "24px",
      "bubble": "18px",
      "button": "12px",
      "badge": "9999px"
    }
  }
}